{
  "name": "qualityhub-testcases",
  "version": "1.0.0",
  "private": true,
  "description": "Учебное приложение: личный реестр тест-кейсов на Node.js, Express и MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cleanup:test": "node scripts/cleanup-test-data.js",
    "seed:demo": "node scripts/seed-demo-data.js",
    "smoke": "node scripts/smoke.js",
    "perf:api": "node scripts/perf-api.js",
    "security:check": "node scripts/security-check.js",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:e2e:edge": "cypress run --browser edge",
    "test:e2e:firefox": "cypress run --browser firefox"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "express",
    "mongoose",
    "jwt",
    "test-cases",
    "educational"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "cypress": "^16.2.1"
  }
}
